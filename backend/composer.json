{
    "name": "sipespek/backend",
    "description": "Backend API untuk SIPESPEK - Sistem Informasi Pelayanan Surat Pengantar Kependudukan Desa Wangkar Weli",
    "type": "project",
    "require": {
        "firebase/php-jwt": "^6.10",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "audit": {
            "abandoned": "report"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
